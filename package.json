{
  "name": "zevanory-product-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run audit:runtime && npm run audit:commercial && npm run test:commercial-robot-auth && npm run test:commercial-contract && npm run test:commercial-cleanup && npm run test:zevanory-sales-contract && npm run test:zevanory-sales-tenant && npm run audit:zevanory-sales-integration && npm run audit:cfo && npm run test:cfo-contract && vite build",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "audit:commercial": "node scripts/ped-commercial-audit.mjs",
    "test:commercial-contract": "tsx scripts/commercial-model-contract.ts",
    "audit:cfo": "node scripts/cfo-audit.mjs",
    "test:cfo-contract": "tsx scripts/cfo-model-contract.ts",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "test:zevanory-sales-contract": "tsx scripts/zevanory-sales-model-contract.ts",
    "audit:zevanory-sales-integration": "node scripts/zevanory-sales-integration-audit.mjs",
    "test:zevanory-sales-tenant": "tsx scripts/zevanory-sales-tenant-contract.ts",
    "test:commercial-cleanup": "tsx scripts/commercial-cleanup-contract.ts",
    "test:commercial-robot-auth": "tsx scripts/commercial-robot-auth-test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@fontsource/inter": "^5.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@netlify/functions": "^6.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0",
    "vite": "^8.3.1"
  }
}
